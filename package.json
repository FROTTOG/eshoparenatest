{
  "name": "kavka-shop",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "pages:dev": "npm run build && wrangler pages dev dist",
    "db:migrate:local": "wrangler d1 migrations apply kavka-shop --local",
    "db:migrate": "wrangler d1 migrations apply kavka-shop --remote",
    "typecheck": "tsc --noEmit && tsc -p functions/tsconfig.json --noEmit",
    "smoke": "tsx scripts/smoke.tsx",
    "smoke:admin": "tsx scripts/smoke-admin.tsx"
  },
  "dependencies": {
    "hono": "^4.13.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.0",
    "vite": "^8.2.0",
    "wrangler": "^4.125.0"
  }
}
