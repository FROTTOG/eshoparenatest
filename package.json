{
  "name": "kavka-shop",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "pages:dev": "npm run build && wrangler pages dev dist",
    "db:migrate:local": "wrangler d1 migrations apply kavka-shop --local",
    "db:migrate": "wrangler d1 migrations apply kavka-shop --remote",
    "typecheck": "tsc --noEmit && tsc -p functions/tsconfig.json --noEmit"
  },
  "dependencies": {
    "hono": "^4.7.5",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.8.2",
    "vite": "^6.2.2",
    "wrangler": "^4.7.0"
  }
}
